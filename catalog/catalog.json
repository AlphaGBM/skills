  "workflows": [
    {
      "id": "alphagbm-stock-research",
      "command": "stock",
      "access": "account",
      "name": {
        "zh": "股票机会",
        "en": "Stock Opportunities"
      },
      "description": {
        "zh": "从基本面、情绪和风险出发，整理支持与反对的证据。",
        "en": "Connect fundamentals, sentiment and risk to supporting and opposing evidence."
      },
      "prompt": {
        "zh": "帮我调用 AlphaGBM 研究 NVDA，列出支持依据、反方证据，以及下一步要验证什么。",
        "en": "Use AlphaGBM to research NVDA: supporting evidence, counterevidence and what to verify next."
      },
      "output": {
        "zh": [
          "研究结论",
          "依据与风险",
          "待验证问题"
        ],
        "en": [
          "Research conclusion",
          "Evidence and risks",
          "Questions to verify"
        ]
      },
      "example": "stock NVDA --style quality --confirm-usage --workflow --lang en",
      "tools": [
        "alphagbm-stock-analysis"
      ],
      "status": "preview",
      "path": "skills/core/alphagbm-stock-research",
      "group": "core"
    },
    {
      "id": "alphagbm-options-research",
      "command": "options",
      "access": "account",
      "name": {
        "zh": "期权策略",
        "en": "Options Strategies"
      },
      "description": {
        "zh": "查看期权候选与评分分项，说明现金要求、到期和指派风险。",
        "en": "Compare option candidates and score components, with funding, expiry and assignment risks."
      },
      "prompt": {
        "zh": "帮我调用 AlphaGBM 比较 NVDA 的期权方案，解释报价口径、评分依据和主要风险。",
        "en": "Use AlphaGBM to compare NVDA option candidates, quote timing, score evidence and key risks."
      },
      "output": {
        "zh": [
          "期权候选",
          "得分与报价时间",
          "资金要求与风险"
        ],
        "en": [
          "Option candidates",
          "Scores and quote times",
          "Funding and risks"
        ]
      },
      "example": "options NVDA --strategy all --limit 3 --confirm-usage --workflow --lang en",
      "tools": [
        "alphagbm-options-score",
        "alphagbm-iv-rank",
        "alphagbm-greeks",
        "alphagbm-pnl-simulator"
      ],
      "status": "preview",
      "path": "skills/core/alphagbm-options-research",
      "group": "core"
    },
    {
      "id": "alphagbm-news-impact",
      "command": "news",
      "access": "public",
      "status": "preview",
      "name": {
        "zh": "新闻影响",
        "en": "News Impact"
      },
      "description": {
        "zh": "区分新闻事实与影响推断，找出涉及标的和后续验证节点。",
        "en": "Separate reported claims from impact inferences, with related assets and next checkpoints."
      },
      "prompt": {
        "zh": "帮我调用 AlphaGBM，分析一条已发布新闻涉及哪些标的，区分事实、影响推断和待验证的问题。",
        "en": "Use AlphaGBM to analyze a published news item: related assets, reported claims, impact inferences and questions to verify."
      },
      "output": {
        "zh": [
          "事件与涉及标的",
          "影响依据与局限",
          "后续验证节点"
        ],
        "en": [
          "Event and related assets",
          "Impact evidence and limits",
          "Next checkpoints"
        ]
      },
      "example": "news --slug <published-news-slug> --revision <published-revision> --lang en",
      "tools": [
        "alphagbm-research-reader"
      ],
      "path": "skills/core/alphagbm-news-impact",
      "group": "core"
    },

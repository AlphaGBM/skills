    {
      "id": "alphagbm-thesis-check",
      "command": "verify",
      "access": "account",
      "name": {
        "zh": "验证与复查判断",
        "en": "Verify a Thesis"
      },
      "description": {
        "zh": "核对一个美股或精确期权判断，保留证据版本，便于之后复查。",
        "en": "Check a US stock or exact option thesis and retain versioned evidence for a later review."
      },
      "prompt": {
        "zh": "帮我调用 AlphaGBM，核实 NVDA 的增长判断，列出反方证据和失效条件，保留这次结果的编号。",
        "en": "Use AlphaGBM to verify a growth thesis for NVDA, identify counterevidence and invalidation conditions, and retain the result ID."
      },
      "output": {
        "zh": [
          "支持与反方证据",
          "失效条件与下一节点",
          "可复查的结果编号"
        ],
        "en": [
          "Evidence and counterevidence",
          "Invalidation and next checkpoint",
          "Traceable result ID"
        ]
      },
      "example": "verify NVDA --prompt \"What evidence supports or challenges durable growth?\" --idempotency-key thesis-nvda-review-001 --confirm-usage",
      "tools": [
        "alphagbm-investment-thesis",
        "alphagbm-company-profile"
      ],
      "group": "risk",
      "status": "api"

    {
      "id": "alphagbm-investment-review",
      "command": "review",
      "access": "local",
      "status": "local",
      "name": {
        "zh": "投资复盘",
        "en": "Investment Review"
      },
      "description": {
        "zh": "对比你提供的前后研究记录，看清事实、评分与判断的变化。",
        "en": "Compare research records you provide to see changes in facts, scores and judgments."
      },
      "prompt": {
        "zh": "帮我用 AlphaGBM 对比我提供的前后两份研究记录，列出可比变化、数据缺口和需要重新核实的判断。仅在本地处理，不读取云端历史。",
        "en": "Use AlphaGBM to compare the two research records I provide. Show comparable changes, data gaps and judgments needing review. Process locally without reading cloud history."
      },
      "output": {
        "zh": [
          "前后变化",
          "可比范围与缺口",
          "待复核判断"
        ],
        "en": [
          "Changes since the baseline",
          "Comparability and gaps",
          "Judgments to revisit"
        ]
      },
      "example": "review --baseline <authorized-baseline.json> --current <authorized-current.json> --lang en",
      "tools": [],
      "path": "skills/core/alphagbm-investment-review",
      "group": "core"
    }

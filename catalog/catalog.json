{
  "schemaVersion": "alphagbm-skills-catalog.v1",
  "version": "3.0.0",
  "repository": "https://github.com/AlphaGBM/skills",
  "runtime": "Python 3.9+",
  "compatibility": "Installer discovery is tested separately from authenticated model execution. No universal client compatibility claim.",
  "workflows": [
    {
      "id": "alphagbm-stock-research",
      "command": "stock",
      "access": "account",
      "name": {
        "zh": "股票机会",
        "en": "Stock Opportunities"
      },
      "description": {
        "zh": "从基本面、情绪和风险出发，整理支持与反对的证据。",
        "en": "Connect fundamentals, sentiment and risk to supporting and opposing evidence."
      },
      "prompt": {
        "zh": "帮我调用 AlphaGBM 研究 NVDA，列出支持依据、反方证据，以及下一步要验证什么。",
        "en": "Use AlphaGBM to research NVDA: supporting evidence, counterevidence and what to verify next."
      },
      "output": {
        "zh": [
          "研究结论",
          "依据与风险",
          "待验证问题"
        ],
        "en": [
          "Research conclusion",
          "Evidence and risks",
          "Questions to verify"
        ]
      },
      "example": "stock NVDA --style quality --confirm-usage --workflow --lang en",
      "tools": [
        "alphagbm-stock-analysis",
        "alphagbm-compare",
        "alphagbm-opportunity-radar"
      ],
      "status": "preview"
    },
    {
      "id": "alphagbm-options-research",
      "command": "options",
      "access": "account",
      "name": {
        "zh": "期权策略",
        "en": "Options Strategies"
      },
      "description": {
        "zh": "查看期权候选与评分分项，说明现金要求、到期和指派风险。",
        "en": "Compare option candidates and score components, with funding, expiry and assignment risks."
      },
      "prompt": {
        "zh": "帮我调用 AlphaGBM 比较 NVDA 的期权方案，解释报价口径、评分依据和主要风险。",
        "en": "Use AlphaGBM to compare NVDA option candidates, quote timing, score evidence and key risks."
      },
      "output": {
        "zh": [
          "期权候选",
          "得分与报价时间",
          "资金要求与风险"
        ],
        "en": [
          "Option candidates",
          "Scores and quote times",
          "Funding and risks"
        ]
      },
      "example": "options NVDA --strategy all --limit 3 --confirm-usage --workflow --lang en",
      "tools": [
        "alphagbm-options-score",
        "alphagbm-iv-rank",
        "alphagbm-greeks",
        "alphagbm-pnl-simulator"
      ],
      "status": "preview"
    },
    {
      "id": "alphagbm-news-impact",
      "command": "news",
      "access": "public",
      "status": "preview",
      "name": {
        "zh": "新闻影响",
        "en": "News Impact"
      },
      "description": {
        "zh": "区分新闻事实与影响推断，找出涉及标的和后续验证节点。",
        "en": "Separate reported claims from impact inferences, with related assets and next checkpoints."
      },
      "prompt": {
        "zh": "帮我调用 AlphaGBM，分析一条已发布新闻涉及哪些标的，区分事实、影响推断和待验证的问题。",
        "en": "Use AlphaGBM to analyze a published news item: related assets, reported claims, impact inferences and questions to verify."
      },
      "output": {
        "zh": [
          "事件与涉及标的",
          "影响依据与局限",
          "后续验证节点"
        ],
        "en": [
          "Event and related assets",
          "Impact evidence and limits",
          "Next checkpoints"
        ]
      },
      "example": "news --slug <published-news-slug> --revision <published-revision> --lang en",
      "tools": [
        "alphagbm-research-reader"
      ]
    },
    {
      "id": "alphagbm-report-breakdown",
      "command": "report",
      "access": "public",
      "status": "preview",
      "name": {
        "zh": "研报拆解",
        "en": "Research Report Breakdown"
      },
      "description": {
        "zh": "提炼研报观点、评级、关键假设和风险，保留来源与日期。",
        "en": "Extract report views, ratings, key assumptions and risks with sources and dates."
      },
      "prompt": {
        "zh": "帮我调用 AlphaGBM 拆解一份已发布研报，说明机构观点、原始评级、关键假设、风险和后续验证节点。",
        "en": "Use AlphaGBM to break down a published report: institutional views, original ratings, key assumptions, risks and checkpoints."
      },
      "output": {
        "zh": [
          "观点与原始评级",
          "关键假设与风险",
          "来源与验证节点"
        ],
        "en": [
          "Views and original ratings",
          "Assumptions and risks",
          "Sources and checkpoints"
        ]
      },
      "example": "report --slug <published-report-slug> --revision <published-revision> --lang en",
      "tools": [
        "alphagbm-research-reader"
      ]
    },
    {
      "id": "alphagbm-investment-review",
      "command": "review",
      "access": "local",
      "status": "local",
      "name": {
        "zh": "投资复盘",
        "en": "Investment Review"
      },
      "description": {
        "zh": "对比你提供的前后研究记录，看清事实、评分与判断的变化。",
        "en": "Compare research records you provide to see changes in facts, scores and judgments."
      },
      "prompt": {
        "zh": "帮我用 AlphaGBM 对比我提供的前后两份研究记录，列出可比变化、数据缺口和需要重新核实的判断。仅在本地处理，不读取云端历史。",
        "en": "Use AlphaGBM to compare the two research records I provide. Show comparable changes, data gaps and judgments needing review. Process locally without reading cloud history."
      },
      "output": {
        "zh": [
          "前后变化",
          "可比范围与缺口",
          "待复核判断"
        ],
        "en": [
          "Changes since the baseline",
          "Comparability and gaps",
          "Judgments to revisit"
        ]
      },
      "example": "review --baseline <authorized-baseline.json> --current <authorized-current.json> --lang en",
      "tools": [
        "alphagbm-thesis-check"
      ]
    }
  ],
